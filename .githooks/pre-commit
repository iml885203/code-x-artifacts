#!/usr/bin/env bash
# Installed by `make hooks`; keep these local checks enabled.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: format, lint, dependencies, docs"
if ! make --no-print-directory verify-precommit; then
	echo
	echo "pre-commit: checks failed. Fix the reported cause and retry the commit."
	exit 1
fi
