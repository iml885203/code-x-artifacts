#!/usr/bin/env bash
# Installed by `make hooks`; keep these local checks enabled.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: build and tests"
if ! make --no-print-directory verify-prepush; then
	echo
	echo "pre-push: checks failed. Fix the reported cause and retry the push."
	exit 1
fi
